{
	"luci-app-openmesh": {
		"description": "Grant access to OpenMesh Manager",
		"read": {
			"ubus": {
				"openmesh": [ "status", "health", "list_nodes", "list_pending", "list_adopted", "get_links", "get_mesh_info" ]
			},
			"uci": [ "openmesh" ]
		},
		"write": {
			"ubus": {
				"openmesh": [ "adopt", "revoke", "mesh_create", "mesh_join", "apply_confirm", "apply_rollback", "roaming_apply" ]
			}
		}
	}
}
